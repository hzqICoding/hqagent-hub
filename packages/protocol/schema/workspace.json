{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace.json",
  "title": "工作区",
  "$defs": {
    "WorkspaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "vcs", "lastOpenedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string", "description": "本机绝对路径" },
        "vcs": { "$ref": "common.json#/$defs/Vcs" },
        "branch": { "type": "string" },
        "isClean": { "type": "boolean", "description": "工作区是否干净。非 clean 时创建写任务要提示" },
        "defaultProfileId": { "type": "string" },
        "lastOpenedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "memoryDirPresent": {
          "type": "boolean",
          "description": "是否存在 .hqagent/ 共享记忆目录（施工方案 §5.5）。不存在时引导用户初始化"
        }
      }
    },
    "WorkspaceQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
