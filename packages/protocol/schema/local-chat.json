{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-chat.json",
  "title": "N0 本地场景与连续对话契约",
  "description": "0.5.0 additive local API with open scene IDs and role templates. Runtime roles retain builtin permission policies.",
  "$defs": {
    "LocalConnectionCodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "expiresInSeconds"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "PickLocalDirectoryInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialPath": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "PickLocalDirectoryView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelled"
      ],
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "selectedPath": {
          "type": "string"
        }
      }
    },
    "LocalSceneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Open scene identifier. analyze, plan, develop are builtin; custom scene IDs are generated by the Worker."
    },
    "LocalRoleConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "agentInstanceId",
        "instructions",
        "enabled"
      ],
      "properties": {
        "roleId": {
          "type": "string"
        },
        "agentInstanceId": {
          "type": "string"
        },
        "instructions": {
          "type": "string",
          "maxLength": 12000
        },
        "modelId": {
          "type": "string",
          "maxLength": 200
        },
        "reasoningEffort": {
          "type": "string",
          "maxLength": 30
        },
        "enabled": {
          "type": "boolean"
        },
        "roleName": {
          "type": "string",
          "maxLength": 120
        },
        "roleTemplateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "roleTemplateVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "LocalSceneView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "readOnly",
        "version",
        "roles",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "local-chat.json#/$defs/LocalSceneId"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "version": {
          "type": "integer"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "local-chat.json#/$defs/LocalRoleConfig"
          }
        },
        "updatedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "reviewMode": {
          "$ref": "local-chat.json#/$defs/ReviewMode"
        },
        "isBuiltin": {
          "type": "boolean"
        }
      }
    },
    "SaveLocalSceneInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "expectedVersion"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "local-chat.json#/$defs/LocalRoleConfig"
          }
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "reviewMode": {
          "$ref": "local-chat.json#/$defs/ReviewMode"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "LocalConversationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "workspaceId",
        "sceneId",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "sceneId": {
          "$ref": "local-chat.json#/$defs/LocalSceneId"
        },
        "createdAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "activeRunId": {
          "type": "string"
        },
        "lastRunId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Metadata revision. Legacy records are revision 1; message/run updates do not increment this revision."
        },
        "archived": {
          "type": "boolean",
          "description": "Archived conversations remain readable. Legacy records default to false."
        },
        "lastRunStatus": {
          "$ref": "common.json#/$defs/TaskStatus"
        }
      }
    },
    "CreateLocalConversationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "workspaceId",
        "sceneId"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sceneId": {
          "$ref": "local-chat.json#/$defs/LocalSceneId"
        }
      }
    },
    "LocalMessageView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "sequence",
        "role",
        "text",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "text": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "common.json#/$defs/Timestamp"
        }
      }
    },
    "SendLocalMessageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientMessageId",
        "text",
        "sessionMode"
      ],
      "properties": {
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "sessionMode": {
          "type": "string",
          "enum": [
            "new",
            "continue"
          ]
        }
      }
    },
    "LocalRunView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conversationId",
        "messageId",
        "taskId",
        "sceneSnapshot",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "sceneSnapshot": {
          "$ref": "local-chat.json#/$defs/LocalSceneView"
        },
        "status": {
          "$ref": "common.json#/$defs/TaskStatus"
        },
        "createdAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "error": {
          "type": "string"
        },
        "task": {
          "$ref": "task.json#/$defs/TaskDetailView"
        }
      }
    },
    "LocalMessageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "conversationId",
        "messageId",
        "runId",
        "status",
        "duplicate"
      ],
      "properties": {
        "commandId": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "accepted"
          ]
        },
        "duplicate": {
          "type": "boolean"
        }
      }
    },
    "LocalEventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "nextSeq",
        "hasMore"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "envelope.json#/$defs/HubEvent"
          }
        },
        "nextSeq": {
          "type": "integer"
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "LocalAuthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        }
      }
    },
    "LocalAuthView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated",
        "protocolVersion"
      ],
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "protocolVersion": {
          "type": "string"
        }
      }
    },
    "LocalAgentModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "efforts",
        "isDefault"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "efforts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isDefault": {
          "type": "boolean"
        }
      }
    },
    "LocalAgentModelsView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentInstanceId",
        "models",
        "verified"
      ],
      "properties": {
        "agentInstanceId": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "local-chat.json#/$defs/LocalAgentModel"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "RoleExecutionOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "modelId": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "ReviewMode": {
      "type": "string",
      "enum": [
        "independent",
        "original_planner"
      ],
      "description": "independent使用独立reviewer；original_planner以验收阶段恢复本轮planner原生会话。省略时兼容旧独立模式。"
    },
    "UpdateLocalConversationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion"
      ],
      "description": "At least one non-null title or archived field is required. Workspace, scene and session associations are immutable.",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "LocalBaseRoleId": {
      "type": "string",
      "enum": [
        "analyst",
        "planner",
        "developer",
        "reviewer"
      ],
      "description": "Validated builtin execution and permission type. Template naming cannot grant extra permissions."
    },
    "CreateLocalSceneInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "roles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "local-chat.json#/$defs/LocalRoleConfig"
          }
        },
        "reviewMode": {
          "$ref": "local-chat.json#/$defs/ReviewMode"
        }
      }
    },
    "CreateLocalRoleTemplateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseRoleId",
        "instructions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "baseRoleId": {
          "$ref": "local-chat.json#/$defs/LocalBaseRoleId"
        },
        "instructions": {
          "type": "string",
          "maxLength": 12000
        }
      }
    },
    "UpdateLocalRoleTemplateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion",
        "name",
        "instructions"
      ],
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instructions": {
          "type": "string",
          "maxLength": 12000
        }
      }
    },
    "LocalRoleTemplateView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseRoleId",
        "instructions",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "baseRoleId": {
          "$ref": "local-chat.json#/$defs/LocalBaseRoleId"
        },
        "instructions": {
          "type": "string",
          "maxLength": 12000
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        }
      }
    }
  }
}
