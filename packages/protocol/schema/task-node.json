{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-node.json",
  "title": "任务节点",
  "description": "一个节点 = 一个角色的一次执行。resolveSource 必须持久化，前端要展示为什么用了这个 Agent（施工方案 §6.4）。",
  "$defs": {
    "TaskNodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "taskId", "roleId", "resolvedAgentId", "resolvedAgentName", "resolveSource", "status"],
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "roleId": { "$ref": "common.json#/$defs/RoleId" },
        "resolvedAgentId": { "type": "string" },
        "resolvedAgentName": { "type": "string" },
        "resolveSource": { "$ref": "common.json#/$defs/ResolveSource" },
        "status": { "$ref": "common.json#/$defs/NodeStatus" },
        "startedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "completedAt": { "$ref": "common.json#/$defs/Timestamp" },
        "outputSummary": { "type": "string" },
        "error": { "type": "string" },
        "isFallback": { "type": "boolean" },
        "fallbackReason": { "type": "string" },
        "sessionId": {
          "type": "string",
          "description": "本节点使用的 Hub 本地会话 ID。同一 Agent 承担实现与审核时，两个节点必须是两个不同的会话（裁决 D7）"
        },
        "externalSessionId": { "type": "string" },
        "worktreePath": { "type": "string" },
        "branch": { "type": "string" },
        "changedFiles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "git diff --name-only 的结果"
        },
        "violationPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "越界修改的路径。非空即判定任务失败，且保留 worktree 供人工查看"
        }
      }
    }
  }
}
