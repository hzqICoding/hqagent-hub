{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap.json",
  "title": "首屏聚合",
  "description": "一次返回首屏所需的全部概况，避免前端启动时打 6 个请求。注意：这里没有 token，也永远不会有——前端拿 token 的唯一途径是 Tauri invoke 读 hub.json（裁决 D3）。",
  "$defs": {
    "BootstrapAgentsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "ready", "issues"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "integer",
          "minimum": 0,
          "description": "not_logged_in / incompatible / error 的合计，首屏要引导用户去处理"
        },
        "lastDiscoveryAt": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "BootstrapUpdateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "hasUpdate", "currentVersion"],
      "properties": {
        "phase": { "$ref": "common.json#/$defs/UpdatePhase" },
        "hasUpdate": { "type": "boolean" },
        "currentVersion": { "type": "string" },
        "latestVersion": { "type": "string" },
        "mandatory": { "type": "boolean" },
        "unacknowledgedResult": {
          "type": "boolean",
          "description": "存在未确认的升级回执，首屏要弹提示"
        }
      }
    },
    "FeatureState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": {
          "type": "string",
          "description": "available=false 时必填。例如「Update Agent 未运行」「Adapter 尚未接入（W2 未完成）」"
        }
      }
    },
    "FeatureAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "teamProfiles", "tasks", "sessions", "approvals", "updates"],
      "properties": {
        "agents": { "$ref": "#/$defs/FeatureState" },
        "teamProfiles": { "$ref": "#/$defs/FeatureState" },
        "tasks": { "$ref": "#/$defs/FeatureState" },
        "sessions": { "$ref": "#/$defs/FeatureState" },
        "approvals": { "$ref": "#/$defs/FeatureState" },
        "updates": { "$ref": "#/$defs/FeatureState" }
      },
      "description": "分阶段交付期间，未就绪的工作包必须在这里明确报 unavailable 并给原因。前端据此禁用入口并显示说明，不允许用空列表伪装成「功能可用但没数据」——那会让集成期的问题晚好几天才暴露"
    },
    "BootstrapView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "appVersion",
        "environment",
        "maintenance",
        "appearance",
        "agents",
        "workspaceCount",
        "activeTasksCount",
        "pendingApprovalsCount",
        "update",
        "features",
        "lastEventSeq",
        "hubStartedAt"
      ],
      "properties": {
        "protocolVersion": { "$ref": "common.json#/$defs/ProtocolVersion" },
        "appVersion": { "type": "string" },
        "environment": { "type": "string", "enum": ["production", "development", "test"] },
        "maintenance": {
          "type": "boolean",
          "description": "true 时前端显示全局维护 Gate，禁用新建任务入口"
        },
        "appearance": { "$ref": "settings.json#/$defs/AppearanceSettings" },
        "agents": { "$ref": "#/$defs/BootstrapAgentsSummary" },
        "defaultProfileId": { "type": "string" },
        "currentWorkspace": { "$ref": "workspace.json#/$defs/WorkspaceView" },
        "workspaceCount": { "type": "integer", "minimum": 0 },
        "activeTasksCount": { "type": "integer", "minimum": 0 },
        "pendingApprovalsCount": { "type": "integer", "minimum": 0 },
        "update": { "$ref": "#/$defs/BootstrapUpdateSummary" },
        "features": { "$ref": "#/$defs/FeatureAvailability" },
        "instanceId": {
          "type": "string",
          "description": "本次 Hub 启动的实例 ID。前端发现它变化即知道 Hub 重启过，应重新 bootstrap 而不是继续用旧 seq"
        },
        "lastEventSeq": {
          "type": "integer",
          "minimum": 0,
          "description": "前端据此建立事件流起点，避免首屏与事件流之间丢事件"
        },
        "hubStartedAt": { "$ref": "common.json#/$defs/Timestamp" }
      }
    }
  }
}
