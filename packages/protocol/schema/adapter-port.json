{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-port.json",
  "title": "Adapter Port 契约（FZ-2）",
  "description": "Hub 与 Agent Adapter 之间的内部端口契约，W2 实现、W3 消费。施工方案 §7.2 只给了 8 行 TypeScript 接口签名，本文件把它的输入输出类型定死。注意：本文件描述的是 Hub 内部端口，不是 Vue 可见的公共 API——Vue 看到的是 agent-instance.json / session.json / agent-event.json 里的 View 模型。Adapter 不得直接向 Vue 暴露任何本文件中的类型。",
  "$defs": {
    "AdapterIntegrationKind": {
      "type": "string",
      "enum": [
        "sdk",
        "cli_stream",
        "mcp",
        "sidecar",
        "gui_automation"
      ],
      "description": "接入方式，按施工方案 §7.1 的可靠性优先级排列。gui_automation 仅为实验性兜底，不得作为正式适配器标准，Role Resolver 不应把它选为主力"
    },
    "AdapterPlatform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ],
      "description": "一期只验收 windows；macos/linux 在 Phase 3"
    },
    "AdapterDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "description": "detect() 的返回值。描述「这个 Adapter 是什么、装没装、能干什么」，是一次性发现结果，不是周期性存活状态——后者见 AdapterHealth。",
      "required": [
        "adapterId",
        "displayName",
        "integrationKind",
        "authKind",
        "supportedPlatforms",
        "installed",
        "capabilities"
      ],
      "properties": {
        "adapterId": {
          "$ref": "common.json#/$defs/AdapterId"
        },
        "displayName": {
          "type": "string"
        },
        "integrationKind": {
          "$ref": "#/$defs/AdapterIntegrationKind"
        },
        "authKind": {
          "$ref": "common.json#/$defs/AuthKind"
        },
        "supportedPlatforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdapterPlatform"
          }
        },
        "installed": {
          "type": "boolean",
          "description": "false 时 detectedVersion / executablePath 可以缺省。发现状态不在本 DTO 里表达：AdapterDescriptor 描述「装了什么」，运行时能不能用由 AdapterHealth 组合出 AgentView.status（裁决 D31）"
        },
        "detectedVersion": {
          "type": "string"
        },
        "minimumVersion": {
          "type": "string",
          "description": "低于此版本必须报 incompatible，不得降级尝试"
        },
        "executablePath": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "description": "Adapter 声明支持的能力。硬能力（capabilities.yaml 里 hard:true）只能由此声明，用户不能在 UI 上勾选覆盖——施工方案 §6.2",
          "items": {
            "$ref": "#/$defs/DeclaredCapability"
          }
        },
        "detectedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        }
      }
    },
    "DeclaredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supported"
      ],
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/CapabilityId"
        },
        "supported": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "description": "supported=false 时说明原因；部分支持也必须报 false 并在此说明，不得报 true 后在运行时静默降级"
        }
      }
    },
    "AdapterHealth": {
      "type": "object",
      "additionalProperties": false,
      "description": "health() 的返回值。周期性探活与登录态检查，比 detect() 轻量，不重新枚举能力。",
      "required": [
        "status",
        "checkedAt"
      ],
      "properties": {
        "status": {
          "$ref": "common.json#/$defs/AgentStatus"
        },
        "checkedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "authValid": {
          "type": "boolean",
          "description": "false 时 status 必须是 not_logged_in。凭据本身绝不出现在本结构里"
        },
        "diagnosticMessage": {
          "type": "string",
          "description": "面向用户的可操作提示，例如「请先运行 claude login」。不得包含 token、路径以外的敏感信息"
        }
      }
    },
    "AgentTaskSpec": {
      "type": "object",
      "additionalProperties": false,
      "description": "start() 的输入。对应施工方案 §8.1 的任务结构，字段名按 D11 转为 camelCase。",
      "required": [
        "sessionId",
        "taskId",
        "nodeId",
        "workspaceId",
        "roleId",
        "objective",
        "sessionPurpose",
        "reusePolicy",
        "allowedPaths"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Hub 本地会话 ID，由 Hub 生成后传入（裁决 D25）。Adapter 收到什么就用什么，不得自行生成——同一 Agent 承担实现与复核时必须是两个不同会话（裁决 D7），这个约束只有 Hub 能保证"
        },
        "taskId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "roleId": {
          "$ref": "common.json#/$defs/RoleId"
        },
        "objective": {
          "type": "string"
        },
        "worktreePath": {
          "type": "string",
          "description": "并发写任务必须给独立 worktree。Adapter 必须以此为工作目录，不得回退到仓库主目录"
        },
        "branch": {
          "type": "string"
        },
        "baseCommit": {
          "type": "string"
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "glob。Adapter 若能在写入前拦截就拦截；不能拦截的，Hub 在 collectResult 时按 changedFiles 校验并发 task.path_violation"
        },
        "readFirst": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "开工前必读文档路径。项目背景靠这个和 handoff 注入，不靠把所有工作塞进一个长期会话——施工方案 §8.2"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "验收命令。Adapter 不负责执行，只负责把它写进给 Agent 的指令"
        },
        "requiresApproval": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/DangerousAction"
          },
          "description": "需要人工审批的动作。Adapter 若不具备 tool_approval 硬能力，Hub 不得把带此字段的任务派给它"
        },
        "sessionPurpose": {
          "$ref": "session.json#/$defs/SessionPurpose"
        },
        "reusePolicy": {
          "$ref": "session.json#/$defs/SessionReusePolicy"
        },
        "resumeSessionId": {
          "type": "string",
          "description": "仅当 reusePolicy=resume_explicit 时有值，且必须是明确的外部会话 ID。禁止 latest 之类不确定值——施工方案 §8.2"
        },
        "handoffDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "上游节点的 handoff 文件路径，由 Hub 注入"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "超过则 Hub 发起 graceful cancel。Adapter 自身不负责计时"
        },
        "readOnly": {
          "type": "boolean"
        },
        "modelId": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "roleInstructions": {
          "type": "string"
        },
        "inputAttachments": {
          "type": "array",
          "items": {
            "$ref": "adapter-port.json#/$defs/AgentInputAttachment"
          },
          "maxItems": 5
        }
      }
    },
    "AgentSessionHandle": {
      "type": "object",
      "additionalProperties": false,
      "description": "start() 的返回值。Adapter 必须在此返回明确的外部会话 ID，Hub 据此写入 SessionView.externalSessionId。",
      "required": [
        "sessionId",
        "adapterId",
        "startedAt",
        "supportsResume"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Hub 本地会话 ID，由 Hub 生成后传给 Adapter，不是 Adapter 生成的"
        },
        "externalSessionId": {
          "type": "string",
          "description": "Claude 的 session_id / Codex 的 thread_id / Antigravity 的 conversation_id。Adapter 声明 session_resume 能力时此字段必填；声明不支持时允许缺省"
        },
        "adapterId": {
          "$ref": "common.json#/$defs/AdapterId"
        },
        "startedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "supportsResume": {
          "type": "boolean",
          "description": "本次会话是否可被后续 resume。与 DeclaredCapability 的 session_resume 可以不同——某些 Agent 只对特定模式的会话支持续接"
        },
        "workingDirectory": {
          "type": "string"
        }
      }
    },
    "ResumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "resume() 的输入。只有用户显式继续、工作流显式声明复用，或任务传入 resumeSessionId 时才会走到这里。",
      "required": [
        "sessionId",
        "message"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Hub 本地会话 ID"
        },
        "externalSessionId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taskSpec": {
          "$ref": "adapter-port.json#/$defs/AgentTaskSpec"
        }
      }
    },
    "CancelMode": {
      "type": "string",
      "enum": [
        "graceful",
        "force"
      ],
      "description": "graceful=向 Agent 发出停止指令并等待它自行收尾；force=直接终止进程/连接。Hub 先 graceful，超时后升级到 force"
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "mode"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/CancelMode"
        },
        "reason": {
          "type": "string"
        },
        "graceSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "mode=graceful 时的等待上限。到点后 Hub 会再发一次 mode=force，Adapter 不得自行延长"
        }
      }
    },
    "CancelOutcome": {
      "type": "string",
      "enum": [
        "stopped_gracefully",
        "force_killed",
        "already_finished",
        "not_found",
        "refused"
      ],
      "description": "refused=Adapter 明确表示无法取消（例如底层 Agent 不提供中断入口）。此时 Hub 必须把节点标记为 failed 而不是 cancelled，并让用户知道该进程可能还在跑——不得假装取消成功"
    },
    "CancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "completedAt"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/CancelOutcome"
        },
        "completedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "orphanProcessIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "outcome=refused 或 force_killed 后仍可能残留的进程。OTA 排空的 waitPids 需要它"
        }
      }
    },
    "ApprovalDispatch": {
      "type": "object",
      "additionalProperties": false,
      "description": "approve() 的输入。Hub 是审批时效的唯一权威——Adapter 不得自行判定过期后放行。",
      "required": [
        "approvalId",
        "decision",
        "decidedAt"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "description": "Hub 侧审批 ID，与 ApprovalView.id 一致"
        },
        "externalRequestId": {
          "type": "string",
          "description": "Adapter 发起审批时携带的供应商侧请求 ID。Adapter 负责把它与 approvalId 关联"
        },
        "decision": {
          "$ref": "common.json#/$defs/ApprovalDecision"
        },
        "reason": {
          "type": "string"
        },
        "decidedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        }
      }
    },
    "AdapterStreamStatus": {
      "type": "string",
      "enum": [
        "streaming",
        "transport_lost",
        "agent_exited",
        "ended"
      ],
      "description": "streamEvents() 的终止原因。transport_lost=连接断了但 Agent 可能还活着，会话保持 active 且可重连；agent_exited=Agent 进程已退出，会话置 invalid；ended=正常收尾。把这两种混为一谈会导致 Hub 要么误判任务失败，要么永远等一个已死的进程"
    },
    "AdapterEvent": {
      "type": "object",
      "additionalProperties": false,
      "description": "streamEvents() 逐条产出的事件（裁决 D32）。故意不带 eventId 和 seq——全局单调 seq 与幂等 eventId 由 Hub 分配，Adapter 直接产出 HubEvent 会把这个所有权弄乱。Hub 收到后补齐这两个字段再落库广播。不冻结这个形状的话，W2 定义一套、W3 消费时再猜一套，接缝正好落在两个包中间",
      "required": [
        "sessionId",
        "type",
        "occurredAt",
        "payload"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Hub 本地会话 ID，即 AgentTaskSpec.sessionId（裁决 D25）"
        },
        "type": {
          "type": "string",
          "description": "必须是 FZ-1 冻结的 28 个事件类型之一，见 events/event-dictionary.md。Adapter 不得新增类型（裁决 D21）"
        },
        "occurredAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "payload": {
          "type": "object",
          "description": "按 type 取 agent-event.json 里对应的 payload 形状"
        },
        "externalRequestId": {
          "type": "string",
          "description": "供应商侧请求 ID。审批类事件必须带上，用于和 ApprovalDispatch 关联（裁决 D33）"
        },
        "vendorEventName": {
          "type": "string",
          "description": "映射自哪个供应商原生事件名，仅供排障。UI 不得据此渲染"
        }
      }
    },
    "AdapterStreamEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "endedAt"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/AdapterStreamStatus"
        },
        "endedAt": {
          "$ref": "common.json#/$defs/Timestamp"
        },
        "lastEventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "resumable": {
          "type": "boolean",
          "description": "仅 transport_lost 时可能为 true"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "AdapterFailureKind": {
      "type": "string",
      "enum": [
        "not_installed",
        "not_logged_in",
        "version_incompatible",
        "capability_missing",
        "transport_error",
        "agent_error",
        "timeout",
        "cancelled",
        "path_violation"
      ],
      "description": "Adapter 失败分类。Hub 据此决定重试、降级还是直接失败，不靠解析错误文案"
    },
    "AdapterFailure": {
      "type": "object",
      "additionalProperties": false,
      "description": "任何 Port 方法失败时的统一结构。接入失败或缺少硬能力必须走这里，不得返回成功后在事件里静默降级。",
      "required": [
        "kind",
        "message",
        "retryable"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/AdapterFailureKind"
        },
        "code": {
          "$ref": "common.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/CapabilityId"
          },
          "description": "kind=capability_missing 时必填，供 Role Resolver 提示能力缺口"
        },
        "violationPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "kind=path_violation 时必填"
        },
        "raw": {
          "type": "string",
          "description": "供应商原始错误摘要，仅用于诊断包。长度上限 2048 字符，超出截断"
        }
      }
    },
    "VendorEventMapping": {
      "type": "object",
      "additionalProperties": false,
      "description": "Adapter 必须声明的供应商事件到统一事件字典的映射表。事件字典已在 FZ-1 冻结（28 条），Adapter 不得新增事件类型。",
      "required": [
        "vendorType",
        "unifiedType"
      ],
      "properties": {
        "vendorType": {
          "type": "string"
        },
        "unifiedType": {
          "type": "string",
          "description": "必须是 events/event-dictionary.md 里已有的类型"
        },
        "dropped": {
          "type": "boolean",
          "description": "true 表示该供应商事件被有意丢弃。丢弃必须显式声明并计数，不得静默吞掉"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "AgentInputAttachment": {
      "type": "object",
      "additionalProperties": false,
      "x-wire-strict": true,
      "required": [
        "attachment",
        "localPath"
      ],
      "properties": {
        "attachment": {
          "$ref": "remote-attachments.json#/$defs/AttachmentManifestItem"
        },
        "localPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "description": "Hub to local Adapter only: verified managed read-only input path, never HTTP response or remote command. Recheck hash/size and allowed input location before passing to model."
    }
  }
}
